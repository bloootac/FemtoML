%notation FemtoML
%package femtoml
%tables lalr

%token NUM(Long) CHAR(Char) ID(String)
%token `(` `)` `[` `]` `<` `>` `\` `.` `,` `|` `@` `=` `:`
%token `let` `in` `and` `rec`
%token `Num` `Char` `Constructor`
%token `data`
%left `;;` `;` `and`
%right `->`

%rules

%include {
	import femtoml.AST._
}

// =======================================================================
program: Program = %empty                              { EmptyStmt }
                 | expr `;;` program                   { SeqStmt($expr, $program) }
                 | decl `;;` program                   { SeqStmt($decl, $program) }

// =======================================================================
expr: Expr = app_expr                                  { $app_expr }
           | `\` ID `.` expr                           { Fun($ID, $expr) }
           | `\` `(` cases: (`|` pattern)* `)`         { CaseFun($cases) }
           | `let` decl `in` expr                      { Let($decl, $expr) }
           
app_expr: Expr = a:app_expr b:const_expr               { Apply($a, $b) }
               | const_expr                            { $const_expr }
               
const_expr: Expr = NUM                                       { Num($NUM) }
                 | CHAR		 		                         { Character($CHAR) }
                 | ID                                        { Identifier($ID)  }
                 | `<` ID `,` `[` args: (`,` expr)* `]` `>`  { Constructor($ID, $args) }
                 | `(` expr `)`                              { $expr }

patt_expr: Expr  = NUM                                            { Num($NUM) }
                 | CHAR		 		                              { Character($CHAR) }
                 | ID                                             { Identifier($ID)  }
                 | `<` ID `,` `[` args: (`,` patt_expr)* `]` `>`  { Constructor($ID, $args) }
                 | `(` patt_expr `)`                              { $patt_expr }

pattern: (Expr, Expr) = a:patt_expr `->` b:expr                  { ($a, $b) }
   			
// =======================================================================
type_expr: TypeExpr = type_expr_body                   { $type_expr_body }
                    | `@` args:(`,` ID)* `.` type_expr { PolyType($args, $type_expr) }

type_expr_body: TypeExpr = 
             a:type_expr_app `->` b:type_expr_body     { FunType($a, $b) }
           | type_expr_app                             { $type_expr_app }
           
type_expr_app: TypeExpr = 
             ID args:(type_expr_atom)+             { ConstructorType($ID, $args) }
           | type_expr_atom                        { $type_expr_atom             }


type_expr_atom: TypeExpr =
             `Num`                                              { NumType }
           | `Char`                                             { CharType }
           | ID                                                 { VarType($ID) }             
           | `(` type_expr `)`                                  { $type_expr }
           			
// =======================================================================
decl: Decl =
       | ID `=` expr	                                                   { ValDec($ID, $expr) }
	   | a:decl `and` b:decl                                               { AndDec($a, $b) }
	   | a:decl `;` b:decl                                                 { SeqDec($a, $b) }
       | `rec` ID `=` expr		                                           { RecDec(ValDec($ID, $expr)) }
	   | ID `:` type_expr	                                               { HasType($ID, $type_expr) }
       | `data` ID vars:(ID)* `=` constructors: (`|` constructor_arg)+     { DataDec($ID, $vars, $constructors) }
       
constructor_arg: (String, List[TypeExpr]) =
         ID args:(type_expr_atom)*                                         { ($ID, $args) }
       

       

       
